#!/bin/sh
# Respuesta activa de Wazuh que bloquea en el firewall la ip atacante (srcip) de una alerta de Slips
# Lee por stdin el mensaje JSON que envia wazuh-execd
# add    -> pregunta a Wazuh si la ip ya tiene un bloqueo vigente (check_keys) y si no, la agrega a la blocklist
# delete -> la quita de la blocklist. Wazuh lo envia solo al cumplirse el timeout del manager
# Se instala en /var/ossec/active-response/bin con dueno root:wazuh y permisos 750

NOMBRE=ndr-bloqueo
LOG=/var/ossec/logs/active-responses.log
NFT=/usr/sbin/nft
JQ=/usr/bin/jq
CONJUNTO="inet ndr blocklist"

# Expiracion propia de nftables, mayor que el timeout del manager (600 s)
# Si el delete de Wazuh no llegara, el bloqueo se elimina igual
EXPIRACION_RESPALDO=15m

registrar() {
  echo "$(date '+%Y/%m/%d %H:%M:%S') $NOMBRE: $*" >> "$LOG"
}

# Extrae un campo del mensaje de entrada
# Ej: campo '.parameters.alert.data.srcip' -> 10.10.10.12
campo() {
  echo "$ENTRADA" | "$JQ" -r "$1 // empty"
}

es_ipv4() {
  echo "$1" | grep -Eq '^([0-9]{1,3}\.){3}[0-9]{1,3}$'
}

# Protocolo con estado de Wazuh: se envia la clave y Wazuh responde continue o abort
# Responde abort si esa ip ya tiene una respuesta activa vigente
wazuh_autoriza() {
  printf '{"version":1,"origin":{"name":"%s","module":"active-response"},"command":"check_keys","parameters":{"keys":["%s"]}}\n' "$NOMBRE" "$IP"
  read -r RESPUESTA
  [ "$(echo "$RESPUESTA" | "$JQ" -r '.command')" = "continue" ]
}

read -r ENTRADA
COMANDO=$(campo '.command')
IP=$(campo '.parameters.alert.data.srcip')
REGLA=$(campo '.parameters.alert.rule.id')
ALERTA_WAZUH=$(campo '.parameters.alert.id')
ALERTA_SLIPS=$(campo '.parameters.alert.data.ID')
DETONANTE="ip=$IP regla=$REGLA alerta_wazuh=$ALERTA_WAZUH alerta_slips=$ALERTA_SLIPS"

# No se ejecuta nada con un valor que no sea una ipv4
if ! es_ipv4 "$IP"; then
  registrar "ERROR srcip invalida o ausente comando=$COMANDO $DETONANTE"
  exit 1
fi

case "$COMANDO" in
  add)
    if ! wazuh_autoriza; then
      registrar "omitido, bloqueo vigente $DETONANTE"
      exit 0
    fi
    if "$NFT" add element $CONJUNTO "{ $IP timeout $EXPIRACION_RESPALDO }"; then
      registrar "bloqueo $DETONANTE"
    else
      registrar "ERROR al bloquear $DETONANTE"
      exit 1
    fi
    ;;
  delete)
    if "$NFT" delete element $CONJUNTO "{ $IP }" 2>/dev/null; then
      registrar "desbloqueo $DETONANTE"
    else
      registrar "desbloqueo sin efecto, la ip ya no estaba en la blocklist $DETONANTE"
    fi
    ;;
  *)
    registrar "ERROR comando desconocido comando=$COMANDO $DETONANTE"
    exit 1
    ;;
esac
