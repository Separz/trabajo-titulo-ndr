<!-- Reglas del NDR. Rango reservado para reglas locales: 100000-120000 -->
<group name="slips,ndr,">
  <rule id="100200" level="3">
    <decoded_as>slips</decoded_as>
    <description>Slips: $(slips.description)</description>
  </rule>
  <rule id="100201" level="5">
    <if_sid>100200</if_sid>
    <field name="slips.priority">^Low$</field>
    <description>Slips (bajo): $(slips.description)</description>
  </rule>
  <rule id="100202" level="7">
    <if_sid>100200</if_sid>
    <field name="slips.priority">^Medium$</field>
    <description>Slips (medio): $(slips.description)</description>
  </rule>
  <rule id="100203" level="10">
    <if_sid>100200</if_sid>
    <field name="slips.priority">^High$</field>
    <description>Slips (alto): $(slips.description)</description>
  </rule>
  <rule id="100204" level="12">
    <if_sid>100200</if_sid>
    <field name="slips.priority">^Critical$</field>
    <description>Slips (critico): $(slips.description)</description>
  </rule>
  <rule id="100210" level="13">
    <if_sid>100203, 100204</if_sid>
    <field name="slips.confidence" type="pcre2">^(1(\.0+)?|0\.[89]\d*)$</field>
    <description>Slips (candidata a respuesta automatica): $(slips.description)</description>
    <group>ndr_respuesta,</group>
  </rule>
</group>
