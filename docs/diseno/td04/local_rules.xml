<!-- Reglas del NDR. Rango reservado para reglas locales: 100000-120000 -->
<!-- Slips escribe dos tipos de registro en alerts.json: -->
<!--   Event    = evidencia de un modulo (una observacion interpretada) -->
<!--   Incident = alerta: la evidencia acumulada del host supero el umbral de Slips -->
<group name="slips,ndr,">
  <rule id="100200" level="3">
    <decoded_as>slips</decoded_as>
    <description>Slips: $(slips.description)</description>
  </rule>

  <!-- Alerta de Slips: decision sobre un host en una ventana de tiempo -->
  <rule id="100210" level="12">
    <if_sid>100200</if_sid>
    <field name="slips.status">^Incident$</field>
    <description>Slips (alerta sobre el host $(srcip)): $(slips.description)</description>
    <group>ndr_respuesta,</group>
  </rule>

  <!-- Evidencias: se registran con un nivel segun su amenaza, pero no disparan respuesta -->
  <rule id="100201" level="5">
    <if_sid>100200</if_sid>
    <field name="slips.status">^Event$</field>
    <field name="slips.priority">^Low$</field>
    <description>Slips (evidencia baja): $(slips.description)</description>
  </rule>
  <rule id="100202" level="7">
    <if_sid>100200</if_sid>
    <field name="slips.status">^Event$</field>
    <field name="slips.priority">^Medium$</field>
    <description>Slips (evidencia media): $(slips.description)</description>
  </rule>
  <rule id="100203" level="9">
    <if_sid>100200</if_sid>
    <field name="slips.status">^Event$</field>
    <field name="slips.priority">^High$</field>
    <description>Slips (evidencia alta): $(slips.description)</description>
  </rule>
  <rule id="100204" level="10">
    <if_sid>100200</if_sid>
    <field name="slips.status">^Event$</field>
    <field name="slips.priority">^Critical$</field>
    <description>Slips (evidencia critica): $(slips.description)</description>
  </rule>
</group>
