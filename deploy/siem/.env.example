# Raiz de este repositorio: el override de Wazuh monta desde aqui ossec.conf, reglas y decodificador
NDR_DIR=
# Direccion que se asigna a ndr0, en CIDR. Slips toma de aqui la red local
# Usar una IP libre del segmento vigilado: Slips trata la IP de su interfaz como propia
# Pruebas con CIC-IDS2017: 192.168.10.254/24
RED_LOCAL=
# Carpeta donde llegan los logs de Zeek desde el sensor; debe contener el enlace current
ZEEK_LOGS=/srv/ndr/zeek
# Salida de Slips; el manager de Wazuh lee live/alerts/alerts.json desde aqui
SLIPS_DIR=/srv/ndr/slips
