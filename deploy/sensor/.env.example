# Interfaz fisica conectada al puerto espejo para captura de paquetes (ver con: ip -br link)
IFACE=
# Interfaz de gestion: SSH y envio de datos fuera del sensor
# Si se define y es distinta de IFACE, sensor-prep.sh deja IFACE
# sin IP ni DHCP (modo promiscuo); MGMT_IFACE conserva su configuracion de red
# Si se deja vacia, IFACE conserva su configuracion de red
MGMT_IFACE=
# Carpeta del host donde Zeek escribe sus logs
LOGS_DIR=/srv/ndr/zeek
# Numero de dias en que se conservan los logs de Zeek
RETENCION_DIAS=30
# Llave publica SSH del host SIEM, ruta relativa a la raiz del repo
# Con ella el SIEM trae los logs con rsync en solo lectura; si falta, sensor-prep.sh omite ese paso
SIEM_PUBKEY=deploy/sensor/siem.pub
